<?xml version="1.0"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.0 http://maven.apache.org/xsd/assembly-1.1.0.xsd">
    <id>src</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <moduleSets>
        <moduleSet>
            <includes>
                <include>hk.hku.cecid:piazza-commons</include>
                <include>hk.hku.cecid:corvus-webapp</include>
                <include>hk.hku.cecid:corvus-main</include>
                <include>hk.hku.cecid:corvus-admin</include>
                <include>hk.hku.cecid:corvus-main-admin</include>
                <include>hk.hku.cecid:corvus-as2</include>
                <include>hk.hku.cecid:corvus-as2-admin</include>
                <include>hk.hku.cecid:corvus-as2plus</include>
                <include>hk.hku.cecid:corvus-as2plus-admin</include>
                <include>hk.hku.cecid:ebxml-pkg</include>
                <include>hk.hku.cecid:corvus-ebms</include>
                <include>hk.hku.cecid:corvus-ebms-admin</include>
                <include>hk.hku.cecid:corvus-sfrm</include>
                <include>hk.hku.cecid:corvus-sfrm-admin</include>
                <include>hk.hku.cecid:corvus-wsclient</include>
                <include>hk.hku.cecid:corvus-api</include>
                <include>hk.hku.cecid:loopback</include>
                <include>hk.hku.cecid:h2o-installer</include>
            </includes>
            <sources>
                <fileSets>
                    <fileSet>
                        <excludes>
                            <exclude>.*</exclude>
                            <exclude>.*/**</exclude>
                            <exclude>target/**</exclude>
                        </excludes>
                    </fileSet>
                </fileSets>
            </sources>
        </moduleSet>
    </moduleSets>
    <files>
        <file>
          <source>spa.xml</source>
          <outputDirectory>${file.separator}</outputDirectory>
        </file>
        <file>
          <source>pom.xml</source>
          <outputDirectory>${file.separator}</outputDirectory>
        </file>
    </files>
    <fileSets>
        <fileSet>
          <directory>${project.basedir}</directory>
          <includes>
            <include>README.md</include>
            <include>LICENSE.txt</include>
            <include>RELEASE-NOTES.txt</include>
            <include>MODERNIZATION.md</include>
            <include>Vagrantfile</include>
            <include>bootstrap.sh</include>
            <include>deploy/**</include>
            <include>scripts/**</include>
            <include>src.xml</include>
          </includes>
        </fileSet>
    </fileSets>
</assembly>
